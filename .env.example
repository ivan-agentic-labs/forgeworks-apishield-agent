# Placeholders only. Do not commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql://localhost:5432/forgeworks_g1
AUTH_ISSUER=
AUTH_AUDIENCE=
# No live agent/sandbox enabled during G1 bootstrap.
ENABLE_AGENT_EXECUTION=false


# No default authentication secret. OIDC is the default mode.
AUTH_MODE=oidc
AUTH_JWKS_URL=
# Development mode is forbidden outside APP_ENV=development/test.
DEV_AUTH_SECRET=
# Separate secret for local signed artifact capabilities; never commit its value.
ARTIFACT_SIGNING_SECRET=

# PostgreSQL runtime requires migrations 001 + 002 and a non-owner application login.
APISHIELD_DATABASE_URL=
APISHIELD_WORKER_TENANTS=
APISHIELD_ARTIFACT_ROOT=

# Set to 0 when running a separate worker process.
APISHIELD_EMBEDDED_WORKER=1

# GitHub App webhook intake requires migration 003 and a separate login that is
# only a member of fw_apishield_webhook. Never reuse the API runtime login.
APISHIELD_GITHUB_WEBHOOK_DATABASE_URL=
GITHUB_WEBHOOK_SECRET=
APISHIELD_GITHUB_READS_ENABLED=0
APISHIELD_GITHUB_APP_ID=
APISHIELD_GITHUB_APP_PRIVATE_KEY=
APISHIELD_GITHUB_SOURCE_MAP_JSON=
# Development/test-only SQLite inbox alternative.
APISHIELD_GITHUB_WEBHOOK_DB_PATH=

# Hosted staging: dedicated schema/login; AUTH_MODE=supabase uses server-owned per-product grants.
SUPABASE_URL=
# APISHIELD_DATABASE_URL must use fw_apishield_agent_login and its private schema search_path.

# Server-only runtime operations. Never put the metrics credential in web/UI configuration.
SUPABASE_PUBLISHABLE_KEY=
FORGEWORKS_RELEASE_SHA=
FORGEWORKS_HTTP_LOGS=0
METRICS_READ_SECRET=
PRODUCTION_ACCEPTANCE_FILE=
PRODUCTION_ACCEPTANCE_PUBLIC_KEY_PEM=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_URL_STYLE=virtual-host
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Production needs separate reviewed infrastructure and a trusted signed acceptance receipt.
