{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/apishield-agent/events/v1.schema.json",
  "title": "APIShield Agent candidate typed domain events v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "tenant_id",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "analysis.completed"
        },
        "event_version": {
          "type": "integer",
          "const": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_id",
            "result_digest",
            "coverage_status",
            "finding_count",
            "unsupported_count"
          ],
          "properties": {
            "analysis_id": {
              "type": "string",
              "format": "uuid"
            },
            "result_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "coverage_status": {
              "type": "string",
              "enum": [
                "COVERED",
                "PARTIAL",
                "UNKNOWN"
              ]
            },
            "finding_count": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "tenant_id",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "proposal.approved"
        },
        "event_version": {
          "type": "integer",
          "const": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposal_id",
            "approval_id",
            "reviewer_id",
            "patch_sha256",
            "base_sha",
            "expires_at"
          ],
          "properties": {
            "proposal_id": {
              "type": "string",
              "format": "uuid"
            },
            "approval_id": {
              "type": "string",
              "format": "uuid"
            },
            "reviewer_id": {
              "type": "string",
              "format": "uuid"
            },
            "patch_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "tenant_id",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "correlation_id",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "const": "pull_request.reconciliation_required"
        },
        "event_version": {
          "type": "integer",
          "const": 1
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_id": {
          "type": "string",
          "format": "uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposal_id",
            "effect_key",
            "repository_id",
            "reason",
            "remote_lookup_marker"
          ],
          "properties": {
            "proposal_id": {
              "type": "string",
              "format": "uuid"
            },
            "effect_key": {
              "type": "string",
              "minLength": 1
            },
            "repository_id": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string",
              "enum": [
                "TIMEOUT",
                "REMOTE_UNCERTAIN",
                "RATE_LIMIT"
              ]
            },
            "remote_lookup_marker": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
